---
// The app's own mark, inlined so it needs no network - carried over from the
// original landing page, which drew it first: the white blaze, edges roughened
// by the turbulence filter the way paint sits on bark, over a ground split
// between forest and stone.
//
// `id` must be unique per instance: SVG filter/clip ids are document-global,
// and two marks sharing them is fine right up until one is inside a element
// that gets display:none'd and takes the defs with it.
interface Props {
  size?: number
  id: string
}
const { size = 34, id } = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 96 96"
  role="img"
  aria-label="OurHike"
>
  <defs>
    <linearGradient id={`${id}-split`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="50%" stop-color="#355c3a"></stop>
      <stop offset="50%" stop-color="#5a5346"></stop>
    </linearGradient>
    <clipPath id={`${id}-round`}>
      <rect width="96" height="96" rx="20"></rect>
    </clipPath>
    <filter id={`${id}-jag`} x="-40%" y="-15%" width="180%" height="130%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.03 0.09"
        numOctaves="2"
        seed="7"
        result="n"></feTurbulence>
      <feDisplacementMap
        in="SourceGraphic"
        in2="n"
        scale="10"
        xChannelSelector="R"
        yChannelSelector="G"></feDisplacementMap>
    </filter>
  </defs>
  <g clip-path={`url(#${id}-round)`}>
    <rect width="96" height="96" fill={`url(#${id}-split)`}></rect>
    <svg x="31" y="8" width="34" height="80" viewBox="0 0 40 100">
      <rect
        x="10"
        y="8"
        width="20"
        height="84"
        rx="10"
        fill="#fff"
        filter={`url(#${id}-jag)`}></rect>
    </svg>
  </g>
</svg>
