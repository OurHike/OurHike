---
// The independence line is load-bearing copy, not boilerplate: the voice
// decision on #116 (2026-08-20, in session) is that this site speaks as an
// independent project serving the trail communities, and this is where that
// is said outright so no page has to hedge it.
//
// The ODbL credit is a licence condition (LAUNCH_CHECKLIST.md §7), not a
// courtesy, and it names OpenStreetMap on every page this footer reaches.
//
// TWO PREFIXES, BECAUSE THIS FOOTER IS ON TWO HOSTS (the docs
// moved off the app's origin; Base.astro works both out). `site` goes before every link
// to one of the site's pages, and is the site's own address on the pages
// docs.ourhike.org serves. `docs` goes before the two data links, and is
// docs.ourhike.org's address once pages.yml has found that host serving the
// docs. Both are empty otherwise, which is the footer as it always was.
import Mark from './Mark.astro'

interface Props {
  site?: string
  docs?: string
}
const { site = '', docs = '' } = Astro.props
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__cols">
      <div class="footer__about">
        <span class="footer__brand">
          <Mark id="footer-mark" size={28} />
          OurHike
        </span>
        <p class="footer__independence">
          OurHike is an independent, open-source project. It is not affiliated
          with or endorsed by the Appalachian Trail Conservancy or any trail
          club — it exists to serve the communities they built, and to be
          handed to them whole if they ever want it.
        </p>
      </div>
      <div class="footer__col">
        <span class="footer__heading">THE SITE</span>
        <a href={`${site}/get-the-app/`}>Get the app</a>
        <a href={`${site}/support/`}>Support the trail</a>
        <a href={`${site}/about/`}>About &amp; values</a>
        <a href={`${site}/status/`}>Status — is it me or us?</a>
        <a href={`${site}/Privacy/`}>Privacy policy</a>
      </div>
      {
        /* FOR ORGS (features/ORG_ONBOARDING.md, #116 Phase 6). A footer column
           costs the homepage nothing and catches the person who came looking
           for it deliberately - which, for an organization, is most of them:
           a trails chair who has been told about this arrives typing, not
           browsing. */
      }
      <div class="footer__col">
        <span class="footer__heading">FOR ORGS</span>
        <a href={`${site}/for-orgs/`}>Add your trail data</a>
        <a href={`${site}/for-orgs/claim/`}>Claim your org</a>
        <a href={`${site}/for-orgs/demo/`}>See a published club</a>
      </div>
      {
        /* THE DATA, LAST: "How the data is built" at /data/how/, the site's
           plain page in front of the dbt docs at /data/, and
           the data-quality page at /data/quality/ (public and
           counts only), which the maintainer chose on 2026-10-08 as how a
           visitor finds them. Both are in site/dist; the dbt docs they link
           to are not - pages.yml and pr-preview.yml copy the docs to /data/
           when they assemble the site. In
           production it is docs.ourhike.org's /data/ once that host serves
           the docs, and `docs` carries the link there. */
      }
      <div class="footer__col">
        <span class="footer__heading">THE PROJECT</span>
        <a href="https://github.com/OurHike/OurHike">Source on GitHub — AGPL-3.0</a>
        <a href="https://github.com/OurHike/OurHike/issues">Tell us what broke</a>
        <a href={`${site}/app/`}>Open the app</a>
        <a href={`${docs}/data/how/`}>How the data is built</a>
        <a href={`${docs}/data/quality/`}>Data quality</a>
      </div>
    </div>
    <p class="footer__credits">
      Trail centerline and facilities: ATC GIS, NYNJTC, NY State Parks, Mohonk
      Preserve, NYS DEC · Map data © OpenStreetMap contributors (ODbL) · Topo:
      USGS US Topo · Elevation: USGS 3DEP · Found a blowdown or a dry spring?
      Report it in the app — it reaches a moderator who can act on it.
    </p>
  </div>
</footer>
