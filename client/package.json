{
  "name": "client",
  "private": true,
  "version": "1.3.5",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run check:build",
    "check:build": "node scripts/check-build-output.mjs",
    "measure:first-run": "node scripts/measure-first-run.mjs",
    "shell:version": "node scripts/shell-version.mjs --write",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run --coverage",
    "test:nocov": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:data": "FLOW_DATA=1 playwright test"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@supabase/supabase-js": "^2.119.2",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "idb-keyval": "^6.3.0",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.19.0",
    "nsfwjs": "^4.4.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@maplibre/maplibre-gl-style-spec": "26.9.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^30.1.3",
    "oxlint": "^1.94.0",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  }
}
