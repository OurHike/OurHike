{
  "name": "campsite-steward-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Campsite Steward's web app: apps/steward/PLAN.md, phase 1 (#1904).",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "VITE_STEWARD_FIXTURES=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "dev:account": "VITE_STEWARD_FIXTURES=1 VITE_STEWARD_FAKE_ACCOUNT=1 vite"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "idb-keyval": "^6.3.0",
