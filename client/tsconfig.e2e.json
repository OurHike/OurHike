{
  /* Playwright-only type-checking, the e2e sibling of tsconfig.test.json:
     identical strictness to the app config, but node types (playwright.config.ts
     reads node:fs and node:path) and none of the app's own globals - no
     jest-dom matchers, which @playwright/test's own `expect` does not share. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["e2e", "playwright.config.ts"],
  "exclude": []
}
