# Site Remediation's database (apps/remediation/db): the migration runner, the
# site loader and their tests. psycopg at backend/'s version, and pytest and
# ruff at the remediation analysis suite's, compiled against both, so one
# interpreter runs every suite in a session.
# backend/requirements-dev.txt's psycopg; backend pins a newer ruff than the
# remediation suites, so it is not a constraints file here.
psycopg[binary]==3.3.6
pytest
ruff
