---
// Whose data is on the map (#1877): every organization with data that
// ships, A to Z, read from pipeline/sources.json when the site is built.
//
// WHY A PAGE OF ITS OWN. The roster went onto the homepage first, as a list
// under the hero, and the maintainer rejected it on sight: 4,195 px of names
// on a 390 px phone, pushing the offline promise five screens down. Three
// layouts for a page of its own went to the maintainer as a mock built from
// the real registry - an A-Z index, groups by what each organization
// shares, and a sortable table - and the index was chosen by poll,
// 2026-10-23.
//
// AN INDEX, AS A GUIDEBOOK HAS ONE. Names under their first letter, and after
// each the number of its datasets that reach the app, where a book's index
// gives a page number. That number is orgRoster.mjs's `datasets`: the
// organization's `reaches_hikers: true` sources, never the ones registered
// and not shipped.
//
// SEARCH IS AN ENHANCEMENT. The box is rendered `hidden` and the script below
// shows it, so a browser without JavaScript gets the letter strip - plain
// anchors - and the whole list, and never a box that does nothing.
//
// NO LOGOS AND NO TRAIL MARKERS. No organization has granted its logo
// (sources.json's org_marks.orgs), and the trail markers that do ship are
// for "the map badge and the line sheet", explicitly "not marketing"
// (org_marks.trail_marks). Names only.
import { readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import Base from '../layouts/Base.astro'
import { byFirstLetter, orgsReachingHikers } from '../lib/orgRoster.mjs'

// No fallback when the file is missing, for the homepage's reason: an index
// of nobody is worse than a build that stops and says why.
const ROSTER = orgsReachingHikers(
  JSON.parse(readFileSync(resolve(process.cwd(), '../pipeline/sources.json'), 'utf8')),
)
const GROUPS = byFirstLetter(ROSTER)
const LETTERS = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', ...(GROUPS.some((g) => g.letter === '#') ? ['#'] : [])]
const FILED = new Set(GROUPS.map((group) => group.letter))
const anchor = (letter: string) => `letter-${letter === '#' ? 'other' : letter}`

const title = 'Whose data is on the map — OurHike'
const description = `The ${ROSTER.length} organizations whose own published trail lines, places, closures and alerts OurHike's map is drawn from, A to Z.`
---

<Base title={title} description={description}>
  <div class="wrap orgs">
    <header class="orgs__head">
      <h1>Whose data is on the map</h1>
      <p class="lede">
        The map is drawn from data {ROSTER.length} organizations publish
        themselves: trail lines, shelters and water, closures and alerts. If
        you look after a trail and you are not here yet,
        <a href="/for-orgs/">add your trail data</a>.
      </p>
    </header>

    <div class="orgs__tools">
      <div class="orgs__search" data-search hidden>
        <label class="orgs__vh" for="org-filter">Find an organization</label>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input id="org-filter" type="search" placeholder="Find an organization" autocomplete="off" spellcheck="false" />
      </div>
      <nav class="orgs__letters" aria-label="Jump to a letter">
        {
          LETTERS.map((letter) =>
            FILED.has(letter) ? (
              <a href={`#${anchor(letter)}`} data-letter={letter}>
                {letter}
              </a>
            ) : (
              <span aria-hidden="true">{letter}</span>
            ),
          )
        }
      </nav>
    </div>

    <p class="orgs__key">The number after each name is how many of its datasets reach the app.</p>
    <p class="orgs__status" role="status" data-status></p>
    <p class="orgs__empty" data-empty hidden>
      If you look after that trail, <a href="/for-orgs/">add your trail data</a>.
    </p>

    <div class="orgs__index">
      {
        GROUPS.map((group) => (
          <section class="orgs__group" id={anchor(group.letter)} aria-labelledby={`${anchor(group.letter)}-head`} data-group>
            <h2 id={`${anchor(group.letter)}-head`}>{group.letter}</h2>
            <ul role="list">
              {group.orgs.map((org) => (
                <li data-name={org.name.toLowerCase()}>
                  <span class="orgs__name">{org.name}</span>
                  <span class="orgs__leader" aria-hidden="true" />
                  <span class="orgs__count">
                    <span class="orgs__vh">, </span>
                    {org.datasets}
                    <span class="orgs__vh"> {org.datasets === 1 ? 'dataset' : 'datasets'}</span>
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>

  <script is:inline>
    // Type to narrow the index: a case-blind match anywhere in the name, so
    // "trail club" finds every trail club and "dnr" nothing it should not.
    ;(function () {
      var box = document.querySelector('[data-search]')
      var input = document.getElementById('org-filter')
      if (!box || !input) return
      box.hidden = false

      var items = [].slice.call(document.querySelectorAll('.orgs__index li'))
      var groups = [].slice.call(document.querySelectorAll('[data-group]'))
      var letters = [].slice.call(document.querySelectorAll('.orgs__letters a'))
      var status = document.querySelector('[data-status]')
      var empty = document.querySelector('[data-empty]')

      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase()
        var shown = 0
        items.forEach(function (li) {
          var hit = q === '' || li.getAttribute('data-name').indexOf(q) !== -1
          li.hidden = !hit
          if (hit) shown++
        })
        groups.forEach(function (group) {
          group.hidden = !group.querySelector('li:not([hidden])')
        })
        letters.forEach(function (a) {
          var group = document.getElementById(a.getAttribute('href').slice(1))
          var off = !group || group.hidden
          a.classList.toggle('is-off', off)
          if (off) a.setAttribute('aria-disabled', 'true')
          else a.removeAttribute('aria-disabled')
        })
        // The count, or what was not found, goes in the live region so a
        // screen reader hears it; the link to add a trail sits under it.
        status.textContent =
          q === ''
            ? ''
            : shown === 0
              ? 'No organization’s name contains “' + input.value.trim() + '”.'
              : shown === 1
                ? '1 organization matches.'
                : shown + ' organizations match.'
        empty.hidden = shown !== 0
      })
    })()
  </script>
</Base>

<style>
  .orgs {
    padding-top: 48px;
    padding-bottom: 72px;
  }

  .orgs__head h1 {
    font-size: clamp(34px, 5vw, 48px);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
  }

  .orgs__head .lede {
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--fg-2);
    max-width: var(--container-narrow);
  }

  /* The box and the letters stay in reach while the list scrolls under them. */
  .orgs__tools {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    margin-top: 28px;
    padding: 10px 0;
    background: var(--bg-page);
  }

  .orgs__search {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 0 1 380px;
    min-height: 48px;
    padding: 0 14px;
    color: var(--fg-3);
    background: var(--bg-surface);
    border: 1.5px solid var(--border-2);
    border-radius: 10px;
  }

  .orgs__search[hidden] {
    display: none;
  }

  .orgs__search:focus-within {
    outline: 3px solid var(--accent-blaze-orange);
    outline-offset: 1px;
  }

  .orgs__search input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    font: inherit;
    font-size: 16px;
    color: var(--fg-1);
    background: transparent;
    border: 0;
    outline: 0;
  }

  .orgs__letters {
    display: flex;
    gap: 1px;
  }

  .orgs__letters a,
  .orgs__letters span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 44px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    border-radius: 6px;
  }

  .orgs__letters a:hover {
    color: var(--fg-1);
    background: var(--bg-sunken);
  }

  .orgs__letters a:focus-visible {
    outline: 3px solid var(--accent-blaze-orange);
    outline-offset: -3px;
  }

  /* A letter with nobody under it, or nobody left after a search: shown so
     the strip keeps its shape, and out of reach. */
  .orgs__letters span,
  .orgs__letters a.is-off {
    color: var(--border-2);
    pointer-events: none;
  }

  .orgs__key {
    margin-top: 6px;
    font-size: 14px;
    color: var(--fg-3);
  }

  .orgs__status:empty {
    display: none;
  }

  .orgs__status,
  .orgs__empty {
    margin-top: 12px;
    font-size: 16px;
    color: var(--fg-2);
  }

  .orgs__empty[hidden] {
    display: none;
  }

  .orgs__index {
    columns: 1;
    column-gap: 52px;
    margin-top: 24px;
  }

  .orgs__group {
    break-inside: avoid;
    margin-bottom: 28px;
    /* Clear of the sticky box and letters when a letter is jumped to. */
    scroll-margin-top: 132px;
  }

  .orgs__group[hidden] {
    display: none;
  }

  .orgs__group h2 {
    font-size: 34px;
    font-weight: 600;
    line-height: 1;
    color: var(--brand-primary);
    padding-bottom: 6px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--border-1);
  }

  .orgs__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .orgs__group li {
    display: flex;
    /* The dots and the count sit on a wrapped name's last line, as an
       index's page number does. */
    align-items: last baseline;
    gap: 6px;
    padding: 6px 0;
    font-size: 15.5px;
    line-height: 1.35;
    color: var(--fg-1);
  }

  .orgs__group li[hidden] {
    display: none;
  }

  .orgs__name {
    flex: 0 1 auto;
  }

  .orgs__leader {
    flex: 1 1 14px;
    min-width: 14px;
    border-bottom: 1.5px dotted var(--border-2);
    transform: translateY(-4px);
  }

  .orgs__count {
    position: relative;
    flex: none;
    font-variant-numeric: tabular-nums;
    font-size: 14.5px;
    color: var(--fg-3);
  }

  /* For a screen reader only. Anchored by its right edge rather than parked
     in a 1px box: a 1px box lets the words run on past the box to the right,
     and next to a count at the edge of a phone that is past the edge of the
     page, where client/e2e/sitePages.spec.ts measures text it cannot see. */
  .orgs__vh {
    position: absolute;
    top: 0;
    right: 0;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* On a phone the letters run past the edge and scroll sideways, rather
     than wrapping into a second sticky row that eats the screen. */
  @media (max-width: 699px) {
    .orgs {
      padding-top: 32px;
    }

    .orgs__search {
      flex-basis: 100%;
    }

    .orgs__letters {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .orgs__letters a,
    .orgs__letters span {
      flex: none;
      width: 32px;
    }

    .orgs__group {
      scroll-margin-top: 136px;
    }
  }

  @media (min-width: 700px) {
    .orgs__index {
      columns: 2;
    }

    .orgs__group {
      scroll-margin-top: 80px;
    }
  }

  @media (min-width: 1000px) {
    .orgs__index {
      columns: 3;
    }
  }
</style>
