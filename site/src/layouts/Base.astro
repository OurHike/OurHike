---
// The shared frame for every page: head, fonts, tokens, nav, footer.
//
// The token import is the §7 "canonical copy" decision in one line: the
// CLIENT's token file is the one copy, and this surface consumes it. See
// src/styles/site.css's header for the whole argument.
import '../../../client/src/design-system/tokens/colors.css'
import '../styles/site.css'
import NavBar from '../components/NavBar.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props

// TWO HOSTS, SINCE THE DOCS MOVED OFF THE APP'S ORIGIN. The pages under /data/
// belong to the data docs' own host, docs.ourhike.org, which serves them
// under /data/ exactly as this site did. This site keeps its own copy at
// /data/ only until pages.yml finds that host serving them, and every
// preview serves its own. So each link is written for every host its page
// can be on:
// - From a /data/ page, the site's other pages are named by the site's full
//   address (`site`, astro.config.mjs's `site`). On docs.ourhike.org a bare
//   `/about/` would name a page that host does not have.
// - From every other page, the two data pages are named through `docs`:
//   PUBLIC_DOCS_ORIGIN when pages.yml found docs.ourhike.org serving the
//   docs and built the site with it, and nothing otherwise, so the link
//   stays on the host that served the page, which then holds the docs at
//   /data/ itself. A /data/ page needs no prefix for them: /data/ is beside
//   it on every host that serves it.
const dataPage = Astro.url.pathname.startsWith('/data/')
const docsOrigin = import.meta.env.PUBLIC_DOCS_ORIGIN ?? ''
const site = dataPage ? Astro.site.origin : ''
const docs = dataPage ? '' : docsOrigin
const canonical = new URL(
  Astro.url.pathname,
  dataPage && docsOrigin ? docsOrigin : Astro.site,
)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {
      /* A page's own head tags, when it has any. The homepage uses it for
         Impact's site verification (#1707), which Impact asks to sit near the
         top of <head>, ahead of the other meta tags. */
    }
    <slot name="head" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      /* Preloaded because the whole page is set in them and font-display:
         swap without a preload means a visible reflash on every first visit.
         Three files, ~76 KB total, latin subsets - see site.css. */
    }
    <link
      rel="preload"
      href="/fonts/bitter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/public-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plex-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    {
      /* THE FIRST THING IN THE TAB ORDER, and it was on none of these pages
         until 2026-09-17. The design handoff carries it on all 27 of its
         screen extracts; the site carried it nowhere, which is a keyboard or
         screen-reader user tabbing the whole nav on every page before
         reaching a word of content.

         It is visually hidden until focused - `.skip` in site.css - so it
         costs a sighted reader nothing and appears the moment somebody
         tabs. */
    }
    <a class="skip" href="#main">Skip to content</a>
    <NavBar site={site} />
    <main id="main">
      <slot />
    </main>
    <Footer site={site} docs={docs} />
  </body>
</html>
