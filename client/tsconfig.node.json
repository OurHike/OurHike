{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* vite.config.ts imports scripts/csp.mjs - the Content-Security-Policy the
       preview serves, which pr-preview.yml also runs as a CLI, so it has to be
       a plain .mjs node can execute (#1602). allowJs is what lets tsc read it;
       checkJs stays off, the same split tsconfig.app.json uses for the design
       system's .jsx. The types are not lost - that file's JSDoc annotates every
       export, so `tsc -b` still checks the call in vite.config.ts against them
       rather than treating the import as `any`. */
    "allowJs": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "capacitor.config.ts"]
}
